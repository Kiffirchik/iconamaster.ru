{
  "name": "premium-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:mtw": "vite build && node scripts/prepare-mtw-build.mjs",
    "preview": "vite preview",
    "check:portability": "node scripts/check-portability.mjs",
    "test:setup": "node --test tests/windows-setup.test.mjs",
    "test": "node scripts/run-unit-tests.mjs",
    "test:content": "node scripts/verify-content.mjs",
    "test:assets": "node scripts/verify-icon-assets.mjs",
    "migrate:inventory": "node scripts/build-content-inventory.mjs",
    "migrate:editorial": "node scripts/migrate-editorial-content.mjs",
    "migrate:icons": "node scripts/migrate-icons.mjs",
    "test:inventory": "node --test tests/unit/legacy-inventory.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:mtw": "node --test tests/mtw-deployment.test.mjs",
    "verify": "npm run check:portability && npm run test:setup && npm test && npm run test:content && npm run test:assets && npm run build && npm run test:sites && npm run build:mtw && npm run test:mtw"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
